digraph Dijkstra {
rankdir=LR;
label="Dijkstra - Step 1";
labelloc=t;
node [shape=circle, style=filled, fontname="Arial"];
"1" [label="Person 1\nDist: 0", fillcolor="gold"];
"2" [label="Person 2\nDist: INF", fillcolor="white"];
"3" [label="Person 3\nDist: INF", fillcolor="white"];
"4" [label="Person 4\nDist: INF", fillcolor="lightpink"];
"1" -> "2" [label="contact (1)", color="gray", penwidth=1];
"1" -> "3" [label="contact (5)", color="gray", penwidth=1];
"2" -> "3" [label="contact (1)", color="gray", penwidth=1];
"3" -> "4" [label="contact (2)", color="gray", penwidth=1];
}
