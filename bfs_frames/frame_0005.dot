digraph BFS {
rankdir=LR;
label="BFS Step 5";
labelloc=t;
node [shape=circle, style=filled, fontname="Arial"];
"1" [label="Person 1", fillcolor="palegreen"];
"2" [label="Person 2", fillcolor="lightblue"];
"3" [label="Person 3", fillcolor="gold"];
"4" [label="Person 4", fillcolor="lightpink"];
"1" -> "2" [label="contact (1)", color="dodgerblue", penwidth=3];
"1" -> "3" [label="contact (5)", color="dodgerblue", penwidth=3];
"2" -> "3" [label="contact (1)", color="gray", penwidth=1];
"3" -> "4" [label="contact (2)", color="gray", penwidth=1];
}
